# =====================================================================
#  ENVIRONMENT VARIABLES
#
#  The dashboard needs NO variables to run. Everything here is optional.
#  Copy this file only if you want to change something:   cp .env.example .env
#  (the dashboard does not load .env by itself: export the variables in your shell,
#   e.g.   set -a; source .env; set +a )
#  Never commit .env (it is git-ignored).
# =====================================================================

# --- Dashboard --------------------------------------------------------

# [OPTIONAL] Port the dashboard listens on (always on 127.0.0.1). Default: 8787
DASHBOARD_PORT=8787

# [OPTIONAL] Id stamped on the drafts created from the dashboard (shows which channel wrote them).
# Default: operator
DASHBOARD_USER_ID=operator

# [OPTIONAL] Name shown in the Despacho's "DECIDIDO" history for your decisions. Default: Operator
DASHBOARD_OPERATOR_NAME=Operator

# [OPTIONAL] Extra Host header values the dashboard accepts besides localhost / 127.0.0.1 / ::1,
# comma-separated (for example a tunnel you own). Any other Host is rejected with 403 (this
# protects the GET endpoints from DNS-rebinding). Leave empty for local use.
DASHBOARD_ALLOWED_HOSTS=

# [OPTIONAL] Root folder the dashboard reads instead of this repository (tests and smoke runs).
PUPPET_ROOT=


# --- Telegram bridge (org/telegram_bridge.py) — DISABLED unless BOTH are set -------
# Without them the bridge prints a notice and exits 0: nothing is sent and nothing fails.
# Create a bot with @BotFather and use your own chat id. There are NO defaults.

# [OPTIONAL] Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# [OPTIONAL] Chat id that receives the reports from reports/outbox/.
TELEGRAM_CHAT_ID=

# [OPTIONAL] Telegram user id allowed to create missions with "mision: <order>".
# If empty it falls back to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_USER_ID=
